{
  "schema_version": 1,
  "provider_id": "alpine",
  "display_name": "Alpine Linux",
  "homepage_url": "https://www.alpinelinux.org/downloads/",
  "driver": "static-html",
  "allowed_hosts": ["www.alpinelinux.org", "dl-cdn.alpinelinux.org"],
  "capabilities": {
    "products": ["alpine-linux"],
    "editions": ["standard", "extended", "virtual", "xen"],
    "flavors": [],
    "architectures": ["x86", "x86_64", "aarch64", "armv7", "loongarch64", "ppc64le", "riscv64", "s390x"],
    "languages": [],
    "channels": ["stable"]
  },
  "release_sources": [
    {
      "source_id": "stable-isos",
      "metadata_url": "https://www.alpinelinux.org/downloads/",
      "artifact_regex": "^alpine-(?P<edition>standard|extended|virtual|xen)-(?P<version>\\d+(?:\\.\\d+)+)-(?P<architecture>x86|x86_64|aarch64|armv7|loongarch64|ppc64le|riscv64|s390x)\\.iso$",
      "identity": {"product_id": "alpine-linux", "edition": "$group:edition", "channel": "stable", "architecture": "$group:architecture"},
      "download": {"strategy": "page-link", "link_regex": "^https://dl-cdn\\.alpinelinux\\.org/alpine/.+/releases/.+/alpine-.+\\.iso$"},
      "verification": {"level": "CHECKSUM", "checksum": {"algorithm": "sha256", "strategy": "sidecar", "suffix": ".sha256"}}
    }
  ],
  "detection": [
    {
      "regex": "^alpine-(?P<edition>standard|extended|virtual|xen)-(?P<version>\\d+(?:\\.\\d+)+)-(?P<architecture>x86|x86_64|aarch64|armv7|loongarch64|ppc64le|riscv64|s390x)\\.iso$",
      "identity": {"product_id": "alpine-linux", "edition": "$group:edition", "channel": "stable", "architecture": "$group:architecture", "version": "$group:version"},
      "downloadable": true
    }
  ]
}
