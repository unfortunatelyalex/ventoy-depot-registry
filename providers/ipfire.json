  "capabilities": {"products": ["ipfire"], "editions": ["installer"], "flavors": [], "architectures": ["x86_64", "aarch64"], "languages": [], "channels": ["stable"]},
  "release_sources": [],
  "detection": [
    {"regex": "^ipfire-(?P<version>\\d+(?:\\.\\d+)+)-core(?P<build>\\d+)-(?P<architecture>x86_64|aarch64)\\.iso$", "identity": {"product_id": "ipfire", "edition": "installer", "channel": "stable", "architecture": "$group:architecture", "version": "$group:version", "build": "$group:build"}, "downloadable": false}
