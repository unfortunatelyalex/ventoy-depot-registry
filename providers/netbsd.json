{
  "schema_version": 1,
  "provider_id": "netbsd",
  "display_name": "NetBSD",
  "homepage_url": "https://www.netbsd.org/releases/",
  "driver": "directory-index",
  "allowed_hosts": ["www.netbsd.org", "cdn.netbsd.org"],
  "capabilities": {
    "products": ["netbsd"],
    "editions": ["installer", "dvd"],
    "flavors": [],
    "architectures": ["acorn32", "alpha", "amd64", "amiga", "arc", "atari", "cats", "cobalt", "dreamcast", "emips", "evbarm-aarch64", "evbarm-aarch64eb", "evbmips-mips64eb", "evbmips-mips64el", "evbmips-mipseb", "evbmips-mipsel", "evbmips-mipsn64eb", "evbmips-mipsn64el", "evbppc", "evbsh3-sh3eb", "evbsh3-sh3el", "ews4800mips", "hp300", "hpcarm", "hpcmips", "hpcsh", "hppa", "i386", "ia64", "ibmnws", "luna68k", "mac68k", "macppc", "mipsco", "mvme68k", "mvmeppc", "news68k", "newsmips", "next68k", "ofppc", "pmax", "prep", "sandpoint", "sgimips", "shark", "sparc", "sparc64", "sun2", "sun3", "vax", "x68k", "zaurus"],
    "languages": [],
    "channels": ["release"]
  },
  "release_sources": [{
    "source_id": "release",
    "metadata_url": "https://cdn.netbsd.org/pub/NetBSD/",
    "artifact_regex": "^NetBSD-(?P<version>\\d+(?:\\.\\d+)+)-(?P<architecture>acorn32|alpha|amd64|amiga|arc|atari|cats|cobalt|dreamcast|emips|evbarm-aarch64|evbarm-aarch64eb|evbmips-mips64eb|evbmips-mips64el|evbmips-mipseb|evbmips-mipsel|evbmips-mipsn64eb|evbmips-mipsn64el|evbppc|evbsh3-sh3eb|evbsh3-sh3el|ews4800mips|hp300|hpcarm|hpcmips|hpcsh|hppa|i386|ia64|ibmnws|luna68k|mac68k|macppc|mipsco|mvme68k|mvmeppc|news68k|newsmips|next68k|ofppc|pmax|prep|sandpoint|sgimips|shark|sparc|sparc64|sun2|sun3|vax|x68k|zaurus)(?:-dvd)?\\.iso$",
    "identity": {"product_id": "netbsd", "channel": "release", "architecture": "$group:architecture"},
    "download": {"strategy": "url-template", "url_template": "https://cdn.netbsd.org/pub/NetBSD/NetBSD-{version}/images/{filename}"},
    "verification": {"level": "CHECKSUM", "checksum": {"algorithm": "sha512", "strategy": "checksum-list", "url_template": "https://cdn.netbsd.org/pub/NetBSD/NetBSD-{version}/images/SHA512"}}
  }],
  "detection": [
    {
      "regex": "^NetBSD-(?P<version>\\d+(?:\\.\\d+)+)-(?P<architecture>amd64|i386|sparc64)-dvd\\.iso$",
      "identity": {"product_id": "netbsd", "edition": "dvd", "channel": "release", "architecture": "$group:architecture", "version": "$group:version"},
      "downloadable": true
    },
    {
      "regex": "^NetBSD-(?P<version>\\d+(?:\\.\\d+)+)-(?P<architecture>acorn32|alpha|amd64|amiga|arc|atari|cats|cobalt|dreamcast|emips|evbarm-aarch64|evbarm-aarch64eb|evbmips-mips64eb|evbmips-mips64el|evbmips-mipsn64eb|evbmips-mipsn64el|evbppc|evbsh3-sh3eb|evbsh3-sh3el|ews4800mips|hp300|hpcarm|hpcmips|hpcsh|hppa|i386|ia64|ibmnws|luna68k|mac68k|macppc|mipsco|mvme68k|mvmeppc|news68k|newsmips|next68k|ofppc|pmax|prep|sandpoint|sgimips|shark|sparc|sparc64|sun2|sun3|vax|x68k|zaurus)\\.iso$",
      "identity": {"product_id": "netbsd", "edition": "installer", "channel": "release", "architecture": "$group:architecture", "version": "$group:version"},
      "downloadable": true
    }
  ],
  "notes": ["All ISO architectures currently published in the official SHA-512 list are supported. DVD media remain a separate edition and are never substituted for standard installer ISOs."]
}
