{
  "schema_version": 1,
  "provider_id": "opnsense",
  "display_name": "OPNsense",
  "homepage_url": "https://opnsense.org/download/",
  "driver": "directory-index",
  "allowed_hosts": ["opnsense.org", "pkg.opnsense.org"],
  "capabilities": {"products": ["opnsense"], "editions": ["dvd", "cdrom"], "flavors": [], "architectures": ["amd64"], "languages": [], "channels": ["stable"]},
  "release_sources": [{
    "source_id": "dvd-amd64",
    "metadata_url": "https://pkg.opnsense.org/releases/mirror/",
    "artifact_regex": "^OPNsense-(?P<version>\\d+(?:\\.\\d+)+)-dvd-amd64\\.iso\\.bz2$",
    "identity": {"product_id": "opnsense", "edition": "dvd", "channel": "stable", "architecture": "amd64"},
    "download": {"strategy": "url-template", "url_template": "https://pkg.opnsense.org/releases/mirror/{filename}"},
    "verification": {"level": "CHECKSUM", "checksum": {"algorithm": "sha256", "strategy": "checksum-list", "url_template": "https://pkg.opnsense.org/releases/mirror/OPNsense-{version}-checksums-amd64.sha256"}},
    "archive": {"format": "bzip2", "output_filename_template": "OPNsense-{version}-dvd-amd64.iso"}
  }],
  "detection": [
    {"regex": "^OPNsense-(?P<version>\\d+(?:\\.\\d+)+)-(?:OpenSSL-)?dvd-(?P<architecture>amd64)\\.iso$", "identity": {"product_id": "opnsense", "edition": "dvd", "channel": "stable", "architecture": "$group:architecture", "version": "$group:version"}, "downloadable": true},
    {"regex": "^OPNsense-(?P<version>\\d+(?:\\.\\d+)+)-(?:OpenSSL-)?cdrom-(?P<architecture>amd64)\\.iso$", "identity": {"product_id": "opnsense", "edition": "cdrom", "channel": "stable", "architecture": "$group:architecture", "version": "$group:version"}, "downloadable": false}
  ],
  "notes": ["Current DVD images are verified as bzip2 archives and extracted transactionally. Historical cdrom media are detected but never converted silently to DVD."]
}
