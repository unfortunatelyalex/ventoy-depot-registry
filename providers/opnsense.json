  "allowed_hosts": ["opnsense.org", "pkg.opnsense.org"],
  "capabilities": {"products": ["opnsense"], "editions": ["dvd", "cdrom"], "flavors": [], "architectures": ["amd64"], "languages": [], "channels": ["stable"]},
  "release_sources": [],
  "detection": [
    {"regex": "^OPNsense-(?P<version>\\d+(?:\\.\\d+)+)-(?:OpenSSL-)?(?P<edition>dvd|cdrom)-(?P<architecture>amd64)\\.iso$", "identity": {"product_id": "opnsense", "edition": "$group:edition", "channel": "stable", "architecture": "$group:architecture", "version": "$group:version"}, "downloadable": false}
