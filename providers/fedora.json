{
  "schema_version": 1,
  "provider_id": "fedora",
  "display_name": "Fedora Linux",
  "homepage_url": "https://fedoraproject.org/",
  "driver": "directory-index",
  "allowed_hosts": ["fedoraproject.org", "download.fedoraproject.org", "dl.fedoraproject.org"],
  "capabilities": {"products": ["fedora"], "editions": ["workstation", "server", "kde", "silverblue", "iot"], "flavors": ["live", "dvd", "ostree"], "architectures": ["x86_64", "aarch64"], "languages": [], "channels": ["stable"]},
  "release_sources": [{"source_id": "stable", "metadata_url": "https://fedoraproject.org/releases.json", "artifact_regex": "^(?=.*(?P<architecture>x86_64|aarch64))Fedora-(?:Workstation-Live|KDE-Desktop-Live|Server-dvd|Silverblue-ostree|IoT-[A-Za-z0-9-]+).+\\.iso$", "identity": {"product_id": "fedora", "channel": "stable", "architecture": "$group:architecture"}, "download": {"strategy": "page-link", "link_regex": "^https://download\\.fedoraproject\\.org/pub/fedora/linux/releases/.+\\.iso$"}, "verification": {"level": "CHECKSUM", "checksum": {"algorithm": "sha256", "strategy": "checksum-list", "url_template": "https://dl.fedoraproject.org/pub/fedora/linux/releases/{version}/{edition}/{architecture}/iso/{checksum_filename}"}}}],
  "detection": [
    {"regex": "^Fedora-(?P<edition>Workstation|KDE-Desktop)-(?P<flavor>Live)-(?P<version>\\d+)-(?P<build>\\d+(?:\\.\\d+)+)\\.(?P<architecture>x86_64|aarch64)\\.iso$", "identity": {"product_id": "fedora", "edition": "$group:edition", "flavor": "$group:flavor", "channel": "stable", "architecture": "$group:architecture", "version": "$group:version", "build": "$group:build"}, "downloadable": true},
    {"regex": "^Fedora-(?P<edition>Server)-(?P<flavor>dvd)-(?P<architecture>x86_64|aarch64)-(?P<version>\\d+)-(?P<build>\\d+(?:\\.\\d+)+)\\.iso$", "identity": {"product_id": "fedora", "edition": "$group:edition", "flavor": "$group:flavor", "channel": "stable", "architecture": "$group:architecture", "version": "$group:version", "build": "$group:build"}, "downloadable": true},
    {"regex": "^Fedora-(?P<edition>Silverblue)-(?P<flavor>ostree)-(?P<architecture>x86_64|aarch64)-(?P<version>\\d+)-(?P<build>\\d+(?:\\.\\d+)+)\\.iso$", "identity": {"product_id": "fedora", "edition": "$group:edition", "flavor": "$group:flavor", "channel": "stable", "architecture": "$group:architecture", "version": "$group:version", "build": "$group:build"}, "downloadable": true}
  ]
}
