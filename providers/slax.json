{
  "schema_version": 1,
  "provider_id": "slax",
  "display_name": "Slax",
  "homepage_url": "https://www.slax.org/en/",
  "driver": "directory-index",
  "allowed_hosts": ["www.slax.org", "ftp.sh.cvut.cz"],
  "capabilities": {"products": ["slax"], "editions": ["debian", "slackware"], "flavors": [], "architectures": ["x86_64", "i386"], "languages": [], "channels": ["stable"]},
  "release_sources": [],
  "detection": [
    {"regex": "^slax-64bit-(?P<version>\\d+(?:\\.\\d+)+)\\.iso$", "identity": {"product_id": "slax", "edition": "debian", "channel": "stable", "architecture": "x86_64", "version": "$group:version"}, "downloadable": false},
    {"regex": "^slax-32bit-(?P<version>\\d+(?:\\.\\d+)+)\\.iso$", "identity": {"product_id": "slax", "edition": "debian", "channel": "stable", "architecture": "i386", "version": "$group:version"}, "downloadable": false},
    {"regex": "^slax-64bit-slackware-(?P<version>\\d+(?:\\.\\d+)+)\\.iso$", "identity": {"product_id": "slax", "edition": "slackware", "channel": "stable", "architecture": "x86_64", "version": "$group:version"}, "downloadable": false},
    {"regex": "^slax-32bit-slackware-(?P<version>\\d+(?:\\.\\d+)+)\\.iso$", "identity": {"product_id": "slax", "edition": "slackware", "channel": "stable", "architecture": "i386", "version": "$group:version"}, "downloadable": false}
  ],
  "notes": ["Slax publishes MD5 rather than SHA-256/SHA-512 for these ISO trees. Debian/Slackware bases and both architectures are detected without enabling unattended updates."]
}
