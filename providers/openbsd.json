{
  "schema_version": 1,
  "provider_id": "openbsd",
  "display_name": "OpenBSD",
  "homepage_url": "https://www.openbsd.org/faq/faq4.html",
  "driver": "checksum-list",
  "allowed_hosts": ["www.openbsd.org", "cdn.openbsd.org"],
  "capabilities": {
    "products": ["openbsd"],
    "editions": ["install", "bootonly"],
    "flavors": [],
    "architectures": ["alpha", "amd64", "arm64", "hppa", "i386", "loongson", "macppc", "powerpc64", "sparc64"],
    "languages": [],
    "channels": ["release"]
  },
  "release_sources": [
    {
      "source_id": "release-index",
      "metadata_url": "https://cdn.openbsd.org/pub/OpenBSD/",
      "artifact_regex": "^(?:install|cd)(?P<version>\\d{2,3})\\.iso$",
      "identity": {"product_id": "openbsd", "edition": "install", "channel": "release", "architecture": "amd64"},
      "download": {"strategy": "user-supplied"},
      "verification": {"level": "CHECKSUM", "checksum": {"algorithm": "sha256", "strategy": "checksum-list"}},
      "automatic_download": false
    }
  ],
  "detection": [
    {
      "regex": "^OpenBSD-(?P<version>\\d+\\.\\d+)-(?P<architecture>alpha|amd64|arm64|hppa|i386|loongson|macppc|powerpc64|sparc64)-(?P<edition>install|bootonly)\\.iso$",
      "identity": {"product_id": "openbsd", "edition": "$group:edition", "channel": "release", "architecture": "$group:architecture", "version": "$group:version"},
      "downloadable": true
    },
    {
      "regex": "^install79\\.iso$",
      "volume_regex": "^OpenBSD/(?P<architecture>alpha|amd64|arm64|hppa|i386|macppc|powerpc64|sparc64)\\s+7\\.9 Install CD$",
      "identity": {"product_id": "openbsd", "edition": "install", "channel": "release", "architecture": "$group:architecture", "version": "7.9"},
      "downloadable": true
    },
    {
      "regex": "^cd79\\.iso$",
      "volume_regex": "^OpenBSD/(?P<architecture>alpha|amd64|arm64|hppa|i386|loongson|macppc|sparc64)\\s+7\\.9 bootonly CD$",
      "identity": {"product_id": "openbsd", "edition": "bootonly", "channel": "release", "architecture": "$group:architecture", "version": "7.9"},
      "downloadable": true
    },
    {
      "regex": "^install78\\.iso$",
      "volume_regex": "^OpenBSD/(?P<architecture>alpha|amd64|arm64|hppa|i386|macppc|powerpc64|sparc64)\\s+7\\.8 Install CD$",
      "identity": {"product_id": "openbsd", "edition": "install", "channel": "release", "architecture": "$group:architecture", "version": "7.8"},
      "downloadable": true
    },
    {
      "regex": "^cd78\\.iso$",
      "volume_regex": "^OpenBSD/(?P<architecture>alpha|amd64|arm64|hppa|i386|loongson|macppc|sparc64)\\s+7\\.8 bootonly CD$",
      "identity": {"product_id": "openbsd", "edition": "bootonly", "channel": "release", "architecture": "$group:architecture", "version": "7.8"},
      "downloadable": true
    },
    {
      "regex": "^install77\\.iso$",
      "volume_regex": "^OpenBSD/(?P<architecture>alpha|amd64|arm64|hppa|i386|macppc|powerpc64|sparc64)\\s+7\\.7 Install CD$",
      "identity": {"product_id": "openbsd", "edition": "install", "channel": "release", "architecture": "$group:architecture", "version": "7.7"},
      "downloadable": true
    },
    {
      "regex": "^cd77\\.iso$",
      "volume_regex": "^OpenBSD/(?P<architecture>alpha|amd64|arm64|hppa|i386|loongson|macppc|sparc64)\\s+7\\.7 bootonly CD$",
      "identity": {"product_id": "openbsd", "edition": "bootonly", "channel": "release", "architecture": "$group:architecture", "version": "7.7"},
      "downloadable": true
    }
  ],
  "notes": [
    "Official installXX.iso and cdXX.iso names omit architecture; their ISO-9660 volume identifier is therefore mandatory for safe detection.",
    "Ventoy Depot uses its audited integrated resolver to select the newest release, architecture directory and SHA256 entry."
  ]
}
